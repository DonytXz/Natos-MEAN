# Server Port
PORT=4200

# Environment
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Natos?retryWrites=true&w=majority

# CORS (use * for all, or comma-separated URLs: http://localhost:4200,https://natos.vercel.app)
CORS_ORIGIN=*
